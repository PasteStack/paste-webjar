<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <packaging>jar</packaging>
    <groupId>com.pastestack</groupId>
    <artifactId>paste-webjar</artifactId>
    <version>2.0.1</version>
    <name>paste-webjar</name>
    <description>WebJar for PasteStack core JS utilities</description>
    <url>https://github.com/PasteStack/paste</url>

    <repositories>
        <repository>
            <id>gitlab-maven</id>
            <url>https://gitlab.com/api/v4/projects/70289607/packages/maven</url>
        </repository>
    </repositories>
    <distributionManagement>
        <repository>
            <id>gitlab-maven</id>
            <url>https://gitlab.com/api/v4/projects/70289607/packages/maven</url>
        </repository>
        <snapshotRepository>
            <id>gitlab-maven</id>
            <url>https://gitlab.com/api/v4/projects/70289607/packages/maven</url>
        </snapshotRepository>
    </distributionManagement>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/PasteStack/paste</url>
        <connection>scm:git:https://github.com/PasteStack/paste.git</connection>
        <developerConnection>scm:git:https://github.com/PasteStack/paste.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <developers>
        <developer>
            <id>sgoggles</id>
            <name>Thomas Schena</name>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <upstreamVersion>2.0.1</upstreamVersion>
        <upstream.url>https://github.com/PasteStack/paste</upstream.url>
        <upstream.release.skip>false</upstream.release.skip>
        <extractDir>${project.build.directory}/paste-${upstreamVersion}</extractDir>
        <destDir>${project.build.outputDirectory}/META-INF/resources/webjars/${project.artifactId}/${project.version}</destDir>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>wagon-maven-plugin</artifactId>
                <version>1.0-beta-4</version>
                <executions>
                    <execution>
                        <id>download-archive</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>download-single</goal>
                        </goals>
                        <configuration>
                            <url>${upstream.url}/archive</url>
                            <fromFile>v${upstreamVersion}.zip</fromFile>
                            <toDir>${project.build.directory}</toDir>
                            <skip>${upstream.release.skip}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>1.7</version>
                <executions>
                    <execution>
                        <id>package-upstream</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${project.build.outputDirectory}/META-INF/resources/webjars/${project.artifactId}" />
                                <delete file="${project.build.outputDirectory}/META-INF/paste-upstream.properties" />
                                <echo message="unzip archive" />
                                <exec executable="unzip">
                                    <arg line="-o ${project.build.directory}/v${upstreamVersion}.zip -d ${project.build.directory}" />
                                </exec>
                                <echo message="moving resources" />
                                <move file="${extractDir}/src" toDir="${destDir}" />
                                <!-- The jar redistributes upstream's sources, so it must
                                     carry upstream's license text and any notice with
                                     them. A missing file fails the build rather than
                                     publishing a redistribution without its terms. -->
                                <echo message="moving upstream license" />
                                <copy file="${extractDir}/LICENSE" toDir="${destDir}" />
                                <copy toDir="${destDir}">
                                    <fileset dir="${extractDir}" erroronmissingdir="false">
                                        <include name="NOTICE.md" />
                                        <include name="NOTICE" />
                                    </fileset>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>development-upstream</id>
            <properties>
                <upstream.release.skip>true</upstream.release.skip>
                <upstream.development.version>develop-11aab249</upstream.development.version>
                <upstream.development.sha256>9ba8b7a433165f6b90ea3261a9cd6ab120fed9f9aab93e3490b29f6c2e847ef6</upstream.development.sha256>
                <upstream.development.url>https://gitlab.com/api/v4/projects/70254161/packages/generic/paste/develop-11aab249/paste-develop-11aab249.tar.gz</upstream.development.url>
                <upstream.license.name>Apache License, Version 2.0</upstream.license.name>
                <upstream.license.url>https://www.apache.org/licenses/LICENSE-2.0</upstream.license.url>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>package-upstream</id>
                                <configuration combine.self="override">
                                    <target>
                                        <mkdir dir="${project.build.directory}" />
                                        <get src="${upstream.development.url}" dest="${project.build.directory}/upstream-development.tar.gz" />
                                        <checksum file="${project.build.directory}/upstream-development.tar.gz" algorithm="SHA-256" property="${upstream.development.sha256}" verifyproperty="upstream.checksum.valid" />
                                        <fail message="Upstream development archive checksum mismatch">
                                            <condition><not><equals arg1="${upstream.checksum.valid}" arg2="true" /></not></condition>
                                        </fail>
                                        <delete dir="${project.build.directory}/upstream-development" />
                                        <mkdir dir="${project.build.directory}/upstream-development" />
                                        <untar src="${project.build.directory}/upstream-development.tar.gz" dest="${project.build.directory}/upstream-development" compression="gzip" />
                                        <loadfile property="upstream.archive.version" srcFile="${project.build.directory}/upstream-development/VERSION">
                                            <filterchain><striplinebreaks /></filterchain>
                                        </loadfile>
                                        <fail message="Upstream development VERSION does not match upstreamVersion">
                                            <condition><not><equals arg1="${upstream.archive.version}" arg2="${upstreamVersion}" /></not></condition>
                                        </fail>
                                        <delete dir="${project.build.outputDirectory}/META-INF/resources/webjars/${project.artifactId}" />
                                        <copy todir="${destDir}/src"><fileset dir="${project.build.directory}/upstream-development/src" /></copy>
                                        <copy file="${project.build.directory}/upstream-development/LICENSE" todir="${destDir}" />
                                        <copy file="${project.build.directory}/upstream-development/NOTICE.md" todir="${destDir}" />
                                        <mkdir dir="${project.build.outputDirectory}/META-INF" />
                                        <echo file="${project.build.outputDirectory}/META-INF/paste-upstream.properties">package=paste
version=${upstream.development.version}
sha256=${upstream.development.sha256}
url=${upstream.development.url}
</echo>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>flatten-maven-plugin</artifactId>
                        <version>1.6.0</version>
                        <configuration>
                            <flattenMode>oss</flattenMode>
                            <updatePomFile>true</updatePomFile>
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <flattenedPomFilename>published-pom.xml</flattenedPomFilename>
                        </configuration>
                        <executions>
                            <execution>
                                <id>flatten-publication</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>flatten</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>